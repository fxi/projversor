{
  "name": "@fxi/projversor",
  "version": "0.1.0-alpha.0",
  "description": "Blended world projections, smooth transitions and WebGL2 composition of vector and raster geographic data",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fxi/projversor.git"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/projversor.js",
  "module": "./dist/projversor.js",
  "types": "./dist/projversor.d.ts",
  "exports": {
    ".": {
      "types": "./dist/projversor.d.ts",
      "import": "./dist/projversor.js"
    },
    "./rendering": {
      "types": "./dist/rendering.d.ts",
      "import": "./dist/rendering.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build --config vite.config.lib.ts",
    "test": "vitest run",
    "test:unit": "vitest run",
    "typecheck": "tsc --noEmit -p .",
    "format": "node node_modules/prettier/bin/prettier.cjs --write \"**/*.{js,jsx,cjs,mjs,ts,tsx,cts,mts}\"",
    "format:check": "node node_modules/prettier/bin/prettier.cjs --check \"**/*.{js,jsx,cjs,mjs,ts,tsx,cts,mts}\"",
    "lint": "node node_modules/eslint/bin/eslint.js . --max-warnings 0",
    "lint:fix": "node node_modules/eslint/bin/eslint.js . --fix --max-warnings 0",
    "quality": "npm run format:check && npm run lint && npm run typecheck",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "projection",
    "webgl2",
    "globe",
    "geojson",
    "d3-geo"
  ],
  "author": "fxi",
  "license": "MIT",
  "dependencies": {
    "d3-ease": "^3.0.1",
    "d3-geo": "^3.1.1"
  },
  "devDependencies": {
    "@types/d3-ease": "^3.0.2",
    "@types/d3-geo": "^3.1.0",
    "@typescript-eslint/parser": "8.46.4",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "globals": "16.5.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-glsl": "^1.5.5",
    "vitest": "^4.1.7"
  }
}
