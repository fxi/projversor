{
  "name": "@fxi/projversor",
  "version": "0.1.0-alpha.0",
  "description": "GeoVideo archives on a sphere that morphs between world projections, rendered with zartigl primitives",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fxi/projversor.git"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "author": "fxi",
  "license": "MIT",
  "scripts": {
    "build:lib": "vite build --config vite.config.lib.ts",
    "test": "vitest run",
    "test:browser": "playwright test -c tests/browser/playwright.config.ts",
    "test:browser:update": "playwright test -c tests/browser/playwright.config.ts --update-snapshots",
    "typecheck": "tsc --noEmit -p .",
    "dev:minimal": "vite --config vite.config.minimal.ts",
    "dev:projection": "vite --config vite.config.projection.ts",
    "dev:story": "vite --config vite.config.story.ts",
    "dev:site": "vite --config vite.config.site.ts",
    "build:demos": "vite build --config vite.config.projection.ts && vite build --config vite.config.story.ts && vite build --config vite.config.site.ts && vite build --config vite.config.minimal.ts",
    "format": "prettier --write \"**/*.{js,mjs,ts}\"",
    "format:check": "prettier --check \"**/*.{js,mjs,ts}\"",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "quality": "npm run format:check && npm run lint && npm run typecheck",
    "release": "npm run release:patch",
    "release:patch": "npm version patch && git push origin main --follow-tags",
    "release:minor": "npm version minor && git push origin main --follow-tags",
    "release:major": "npm version major && git push origin main --follow-tags",
    "prepublishOnly": "npm run build:lib"
  },
  "dependencies": {
    "@fxi/zartigl": "^0.7.0",
    "@types/d3": "^7.4.3",
    "d3": "^7.9.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@fontsource-variable/inter-tight": "^5.3.0",
    "@playwright/test": "1.64.1",
    "@types/topojson-client": "^3.1.5",
    "@typescript-eslint/parser": "^8.46.4",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-glsl": "1.5.5",
    "vitest": "^4.1.7"
  }
}
